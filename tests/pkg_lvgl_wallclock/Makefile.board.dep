ifeq (feather-nrf52840,$(BOARD))
  USEMODULE += ds3231
  # Include GNRC
  USEMODULE += auto_init_gnrc_netif
  USEMODULE += gnrc_ipv6_router_default
  USEMODULE += gnrc_icmpv6_echo
  # Setup Nimble
  USEMODULE += nimble_netif
  USEMODULE += nimble_autoconn_ipsp
else
  USEMODULE += ztimer_sec
  USEMODULE += rtc_utils
endif
